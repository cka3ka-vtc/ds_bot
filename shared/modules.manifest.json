{
  "modules": [
    {
      "key": "greetings",
      "name": "Приветствия",
      "description": "Автоматически приветствует новых участников и прощается с ушедшими",
      "icon": "fa-hand",
      "color": "green",
      "category": "engagement",
      "version": "2.1.0",
      "defaultEnabled": false,
      "events": ["guildMemberAdd", "guildMemberRemove"],
      "configSchema": {
        "channelId": { "type": "text", "label": "ID канала" },
        "events":    { "type": "json", "label": "События" },
        "messages":  { "type": "json", "label": "Сообщения" }
      }
    },
    {
      "key": "levels",
      "name": "Уровни",
      "description": "XP за активность, уровни и автовыдача ролей",
      "icon": "fa-ranking-star",
      "color": "orange",
      "category": "engagement",
      "version": "2.0.0",
      "defaultEnabled": false,
      "events": ["messageCreate", "interactionCreate", "voiceStateUpdate"],
      "configSchema": {
        "announceChannelId": { "type": "text", "label": "ID канала объявлений" },
        "formula": { "type": "text", "label": "Формула" },
        "maxLevel": { "type": "number", "label": "Максимальный уровень" },
        "boostMultiplier": { "type": "number", "label": "Множитель за буст" },
        "events": { "type": "json", "label": "XP и кулдауны" },
        "rewards": { "type": "json", "label": "Награды" },
        "excludedChannels": { "type": "json", "label": "Исключённые каналы" },
        "excludedRoles": { "type": "json", "label": "Исключённые роли" },
        "inactivity": { "type": "json", "label": "Снятие за неактивность" },
        "messages": { "type": "json", "label": "Сообщения" }
      }
    },
    {
      "key": "events",
      "name": "События",
      "description": "Планирование ивентов и автоматические напоминания",
      "icon": "fa-calendar-check",
      "color": "blue",
      "category": "engagement",
      "version": "1.0.0",
      "defaultEnabled": false,
      "events": [],
      "configSchema": {
        "announceChannelId": { "type": "text",   "label": "ID канала анонсов" },
        "reminderMinutes":   { "type": "number", "label": "Напоминание за (мин)", "default": 60 },
        "template":          { "type": "textarea","label": "Шаблон анонса" }
      }
    },
    {
      "key": "birthdays",
      "name": "Дни рождения",
      "description": "Поздравления и роль именинника на 24 часа",
      "icon": "fa-cake-candles",
      "color": "pink",
      "category": "engagement",
      "version": "2.1.0",
      "defaultEnabled": false,
      "events": ["guildMemberUpdate"],
      "configSchema": {
        "announceChannelId": { "type": "text", "label": "Канал объявлений" },
        "birthdayRoleId":    { "type": "text", "label": "Роль именинника" },
        "sendTime":          { "type": "text", "label": "Время отправки (HH:MM)" },
        "messages":          { "type": "json", "label": "Сообщения" }
      }
    },
    {
      "key": "sticky",
      "name": "Липнущее сообщение",
      "description": "Сообщение, которое переопубликовывается при каждом новом сообщении в канале",
      "icon": "fa-thumbtack",
      "color": "purple",
      "category": "engagement",
      "version": "1.0.0",
      "defaultEnabled": false,
      "events": ["messageCreate"],
      "configSchema": {}
    },
    {
      "key": "moderation",
      "name": "Автомодерация",
      "description": "Фильтры, карта нарушений и автоматические наказания",
      "icon": "fa-shield-halved",
      "color": "red",
      "category": "moderation",
      "version": "2.0.0",
      "defaultEnabled": false,
      "events": ["messageCreate", "guildMemberAdd"],
      "configSchema": {
        "logChannelId":             { "type": "text",    "label": "Канал логов" },
        "defaultAction":            { "type": "text",    "label": "Действие по умолчанию" },
        "filters":                  { "type": "json",    "label": "Настройки фильтров" },
        "escalation":               { "type": "json",    "label": "Карта нарушений" },
        "globalExcludedChannels":   { "type": "json",    "label": "Глобально исключённые каналы"},
        "globalExcludedRoles":      { "type": "json",    "label": "Глобально исключённые роли" },
        "templateDm":               { "type": "textarea","label": "Шаблон ЛС" },
        "templateLog":              { "type": "textarea","label": "Шаблон лога" }
      }
    },
    {
      "key": "autoroles",
      "name": "Автороли",
      "description": "Выдача ролей при входе или по реакциям",
      "icon": "fa-user-tag",
      "color": "red",
      "category": "moderation",
      "version": "1.0.0",
      "defaultEnabled": false,
      "events": ["guildMemberAdd"],
      "configSchema": {
        "joinRoleId":        { "type": "text",    "label": "ID роли при входе" },
        "reactionChannelId": { "type": "text",    "label": "ID канала с реакциями" },
        "removeOnLeave":     { "type": "boolean", "label": "Снимать роль при выходе", "default": false }
      }
    },
    {
      "key": "autodelete",
      "name": "Автоудаление",
      "description": "Правила автоудаления сообщений в выбранных каналах",
      "icon": "fa-trash",
      "color": "red",
      "category": "moderation",
      "version": "2.0.0",
      "defaultEnabled": false,
      "events": ["messageCreate"],
      "configSchema": {}
    },
    {
      "key": "scheduled",
      "name": "Отложенные сообщения",
      "description": "Автоматическая отправка сообщений в заданную дату и время",
      "icon": "fa-clock",
      "color": "pink",
      "category": "utility",
      "version": "2.0.0",
      "defaultEnabled": false,
      "events": [],
      "configSchema": {}
    },
    {
      "key": "messages",
      "name": "Интерактивные сообщения",
      "description": "Кнопки-роли из редактора сообщений",
      "icon": "fa-hand-pointer",
      "color": "purple",
      "category": "utility",
      "version": "1.1.0",
      "defaultEnabled": false,
      "events": ["interactionCreate"],
      "configSchema": {
        "templates": { "type": "json", "label": "Шаблоны сообщений" }
      }
    },
    {
      "key": "message-templates",
      "name": "Сообщения",
      "description": "Заготовленные сообщения — отправляйте в канал в любой момент",
      "icon": "fa-message",
      "color": "blue",
      "category": "utility",
      "version": "1.0.0",
      "defaultEnabled": false,
      "events": [],
      "configSchema": {}
    },
    {
      "key": "tickets",
      "name": "Тикеты",
      "description": "Система поддержки с приватными каналами",
      "icon": "fa-ticket",
      "color": "blue",
      "category": "support",
      "version": "1.0.0",
      "defaultEnabled": false,
      "events": ["interactionCreate"],
      "configSchema": {
        "categoryId":         { "type": "text",   "label": "ID категории Discord" },
        "supportRoleId":      { "type": "text",   "label": "ID роли поддержки" },
        "welcomeMessage":     { "type": "textarea","label": "Приветствие в тикете" },
        "autoCloseHours":     { "type": "number", "label": "Автозакрытие (ч)", "default": 24 }
      }
    }
  ]
}